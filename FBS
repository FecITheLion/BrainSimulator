    def _clear_placeholder(self, event=None):
        if self.prompt.get().startswith("Type a prompt"):
            self.prompt.delete(0, tk.END)
            self.prompt.config(fg="#ffffff" if self.dark_mode else "#212121")

    def _restore_placeholder(self, event=None):
        if not self.prompt.get().strip():
            self.prompt.insert(0, "Type a prompt (e.g. years 66 acidity 7.4) or leave blank to use settings...")
            self.prompt.config(fg="#888888")

    def copy_selected(self):
        try:
            text = self.chat.get(tk.SEL_FIRST, tk.SEL_LAST)
            self.clipboard_clear()
            self.clipboard_append(text)
            self.status.config(text="Selected text copied.")
        except tk.TclError:
            self.status.config(text="No text selected.")

    def copy_all(self):
        text = self.chat.get(1.0, tk.END)
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status.config(text="Entire chat copied.")

    def open_file(self, path):
        try:
            os.startfile(path)
        except Exception:
            try:
                import subprocess
                subprocess.Popen(["xdg-open", path])
            except Exception:
                messagebox.showinfo("Open", f"File: {path}")

    def show_lightbox(self, path):
        """Modal lightbox showing a larger version of the resource thumbnail."""
        if not os.path.exists(path):
            messagebox.showwarning("Lightbox", "File not found.")
            return
        modal = tk.Toplevel(self)
        modal.title(f"Full Size View — {os.path.basename(path)}")
        modal.transient(self)
        modal.grab_set()  # modal
        modal.configure(bg="#111111")
        # Center it
        modal.geometry("800x600")
        modal.update_idletasks()
        x = self.winfo_x() + (self.winfo_width() // 2) - 400
        y = self.winfo_y() + (self.winfo_height() // 2) - 300
        modal.geometry(f"+{max(0,x)}+{max(0,y)}")

        try:
            from PIL import Image as PILImage, ImageTk
            img = PILImage.open(path)
            # Scale to fit nicely
            max_w, max_h = 760, 520
            img.thumbnail((max_w, max_h), PILImage.Resampling.LANCZOS)
            photo = ImageTk.PhotoImage(img)
            # Keep reference
            modal.photo = photo
            lbl = tk.Label(modal, image=photo, bg="#111111")
            lbl.pack(expand=True, pady=10)
        except Exception as e:
            tk.Label(modal, text=f"Could not load image:\n{e}", fg="white", bg="#111111").pack(expand=True)

        btn_frame = tk.Frame(modal, bg="#111111")
        btn_frame.pack(pady=8)
        tk.Button(btn_frame, text="Open Full File", command=lambda: self.open_file(path)).pack(side=tk.LEFT, padx=6)
        tk.Button(btn_frame, text="Download", command=lambda: self._download_file(path, modal)).pack(side=tk.LEFT, padx=6)
        tk.Button(btn_frame, text="Close", command=modal.destroy).pack(side=tk.LEFT, padx=6)
        modal.bind("<Escape>", lambda e: modal.destroy())
        modal.focus_set()

    def _download_file(self, path, parent=None):
        """Save a copy of the resource via file dialog."""
        if not os.path.exists(path):
            messagebox.showwarning("Download", "Source file not found.", parent=parent)
            return
        base = os.path.basename(path)
        name, ext = os.path.splitext(base)
        dest = filedialog.asksaveasfilename(
            parent=parent,
            title="Download resource",
            initialfile=base,
            defaultextension=ext,
            filetypes=[("All files", "*.*"), ("Images", "*.png *.jpg *.jpeg"), ("PDF", "*.pdf"), ("Text", "*.txt")]
        )
        if dest:
            try:
                import shutil
                shutil.copy2(path, dest)
                messagebox.showinfo("Download", f"Saved to:\n{dest}", parent=parent)
                self.status.config(text=f"Downloaded: {os.path.basename(dest)}")
            except Exception as e:
                messagebox.showerror("Download", str(e), parent=parent)

    def append_message(self, role, text, files=None):
        self.chat.config(state="normal")
        if role == "user":
            self.chat.insert(tk.END, "In: ", "in_label")
            self.chat.insert(tk.END, text + "\n", "in_bubble")
        elif role == "assistant":
            self.chat.insert(tk.END, "Out: ", "out_label")
            self.chat.insert(tk.END, text + "\n", "out_bubble")
            # Add per-message copy tag
            start = self.chat.index("end-2c linestart")
            self.chat.insert(tk.END, " [Copy this] ", "copy_btn")
            self.chat.tag_bind("copy_btn", "<Button-1>", lambda e, t=text: self._copy_text(t))
        else:
            self.chat.insert(tk.END, text + "\n", "system")
        # Files as clickable links + thumbnails if images
        if files:
            for fpath, label in files:
                if not os.path.exists(fpath):
                    continue
                self.chat.insert(tk.END, f"  • {label}: ", "system")
                link_tag = f"link_{id(fpath)}"
                self.chat.tag_config(link_tag, foreground="#64b5f6", underline=True)
                self.chat.insert(tk.END, os.path.basename(fpath), link_tag)
                self.chat.tag_bind(link_tag, "<Button-1>", lambda e, p=fpath: self.open_file(p))
                # Download button/link next to the full file
                dl_tag = f"dl_{id(fpath)}"
                self.chat.tag_config(dl_tag, foreground="#ffb74d", underline=True)
                self.chat.insert(tk.END, " [Download]", dl_tag)
                self.chat.tag_bind(dl_tag, "<Button-1>", lambda e, p=fpath: self._download_file(p))
                self.chat.insert(tk.END, " (click name to open, or Download)\n", "system")
                # Thumbnail for PNGs — click opens lightbox modal
                if fpath.lower().endswith((".png", ".jpg", ".jpeg")) and HAS_MPL:
                    try:
                        from PIL import Image as PILImage, ImageTk
                        img = PILImage.open(fpath)
                        img.thumbnail((180, 120))
                        photo = ImageTk.PhotoImage(img)
                        self.photo_refs.append(photo)
                        thumb_tag = f"thumb_{id(fpath)}"
                        self.chat.tag_config(thumb_tag)
                        self.chat.insert(tk.END, " ")  # anchor
                        start = self.chat.index(tk.END)
                        self.chat.image_create(tk.END, image=photo)
                        end = self.chat.index(tk.END)
                        self.chat.tag_add(thumb_tag, start, end)
                        self.chat.tag_bind(thumb_tag, "<Button-1>", lambda e, p=fpath: self.show_lightbox(p))
                        self.chat.insert(tk.END, " (click thumbnail to open full size view)\n", "system")
                    except Exception:
                        pass  # PIL may not be present
        self.chat.insert(tk.END, "\n")
        self.chat.config(state="disabled")
        self.chat.see(tk.END)

    def _copy_text(self, text):
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status.config(text="Message copied.")

    def apply_theme(self):
        if self.dark_mode:
            bg, fg, entry_bg, entry_fg, chat_bg, chat_fg = "#1e1e1e", "#e0e0e0", "#2d2d2d", "#ffffff", "#1a1a1a", "#e8e8e8"
            header_fg = "#4fc3f7"
        else:
            bg, fg, entry_bg, entry_fg, chat_bg, chat_fg = "#f5f5f5", "#212121", "#ffffff", "#212121", "#ffffff", "#212121"
            header_fg = "#1565c0"
        self.configure(bg=bg)
        s = self.style
        s.configure("TFrame", background=bg)
        s.configure("TLabel", background=bg, foreground=fg)
        s.configure("Header.TLabel", font=("Segoe UI", 12, "bold"), foreground=header_fg)
        s.configure("TLabelframe", background=bg, foreground=fg)
        s.configure("TLabelframe.Label", background=bg, foreground=fg)
        if hasattr(self, "prompt"):
            self.prompt.configure(bg=entry_bg, fg=entry_fg, insertbackground=entry_fg)
        if hasattr(self, "chat"):
            self.chat.configure(bg=chat_bg, fg=chat_fg)
            self.chat.tag_config("in_label", foreground=header_fg)
            self.chat.tag_config("out_label", foreground="#81c784" if self.dark_mode else "#2e7d32")
            self.chat.tag_config("in_bubble", background="#1e3a5f" if self.dark_mode else "#e3f2fd", foreground=chat_fg)
            self.chat.tag_config("out_bubble", background="#2d2d2d" if self.dark_mode else "#f5f5f5", foreground=chat_fg)
        for e in (getattr(self, "dev_history", None), getattr(self, "behavior_obs", None),
                  getattr(self, "ados2_note", None), getattr(self, "adir_note", None)):
            if e:
                e.configure(bg=entry_bg, fg=entry_fg, insertbackground=entry_fg)

    def toggle_theme(self):
        self.dark_mode = not self.dark_mode
        self.apply_theme()
        self.status.config(text=f"{'Dark' if self.dark_mode else 'Light'} mode")

    def clear_chat(self):
        self.chat.config(state="normal")
        self.chat.delete(1.0, tk.END)
        self.chat.config(state="disabled")
        self.append_message("system", "Chat cleared.")

    def open_reports(self):
        try:
            os.startfile(REPORT_DIR)  # Windows
        except Exception:
            try:
                import subprocess
                subprocess.Popen(["xdg-open", REPORT_DIR])  # Linux
            except Exception:
                messagebox.showinfo("Reports", f"Reports folder:\n{REPORT_DIR}")

    def run_analysis(self):
        try:
            user_text = self.prompt.get().strip()
            if not user_text or user_text.startswith("Type a prompt"):
                user_text = f"years {self.vars['age'].get()} acidity {self.vars['ph'].get()} thyroid {self.vars['horm'].get()}"
            # Check for chart query like "value at 45"
            m = re.search(r'value at\s+([-+]?\d*\.?\d+)', user_text.lower())
            if m and self.last:
                query_age = float(m.group(1))
                eng = compute_chart_engagements(self.last)
                # simple nearest
                ages = eng['ages']
                thicks = eng['thicks']
                if query_age <= ages[0]:
                    qval = thicks[0]
                elif query_age >= ages[-1]:
                    qval = thicks[-1]
                else:
                    for i in range(len(ages)-1):
                        if ages[i] <= query_age <= ages[i+1]:
                            frac = (query_age - ages[i]) / (ages[i+1] - ages[i])
                            qval = thicks[i] + frac * (thicks[i+1] - thicks[i])
                            break
                    else:
                        qval = thicks[-1]
                self.append_message("user", user_text)
                self.append_message("assistant", f"Thickness at age {query_age:.1f}: {qval:.1f} nm (interpolated from lifespan curve).")
                self.prompt.delete(0, tk.END)
                self._restore_placeholder()
                return
            self.append_message("user", user_text)
            self.prompt.delete(0, tk.END)
            self._restore_placeholder()

            age, ph, horm, id_flag, ca, cyto = parse_prompt(user_text)
            try:
                age = float(self.vars["age"].get())
                ph = float(self.vars["ph"].get())
                horm = float(self.vars["horm"].get())
                ca = float(self.vars["ca"].get())
                cyto = float(self.vars["cyto"].get())
                id_flag = int(self.vars["id"].get())
            except Exception:
                pass

            phase, scale = get_phase(age)
            thick, delta, g, vel = myelin_metrics(age, ph, horm, id_flag, ca, cyto)
            nn = nn_forward(age, ph, horm, id_flag, ca, cyto, scale)
            self.last = dict(
                age=age, ph=ph, horm=horm, id_flag=id_flag, ca=ca, cyto=cyto,
                phase=phase, scale=scale, thick=thick, delta=delta, g=g, vel=vel, nn=nn,
                sex=self.vars["sex"].get(), thyroid=self.vars["thyroid"].get(),
                symptom=self.vars["symptom"].get(), myelination=self.vars["myelination"].get(),
                inflammation=self.vars["inflammation"].get(), cognitive=self.vars["cognitive"].get(),
                dev_history=self.dev_history.get().strip(),
                behavior_obs=self.behavior_obs.get().strip(),
                ados2_note=self.ados2_note.get().strip(),
                adir_note=self.adir_note.get().strip()
            )
            summary = generate_discharge_summary(self.last)
            self.append_message("assistant", summary)

            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            clear_report_dir()
            chart_paths = generate_charts(self.last, timestamp)
            notes_path = generate_notes(self.last, summary, timestamp)
            pdf_path = generate_pdf(self.last, summary, chart_paths, timestamp) if HAS_RL else None

            files = []
            if notes_path:
                files.append((notes_path, "Notes"))
            if pdf_path:
                files.append((pdf_path, "PDF Report"))
            for cp in chart_paths:
                files.append((cp, "Chart"))
            # Add containing folder link
            folder_link_tag = "folder_link"
            self.chat.config(state="normal")
            self.chat.insert(tk.END, "  • Containing folder: ", "system")
            self.chat.tag_config(folder_link_tag, foreground="#64b5f6", underline=True)
            self.chat.insert(tk.END, "Featured_Reports\\myelin_reports", folder_link_tag)
            self.chat.tag_bind(folder_link_tag, "<Button-1>", lambda e: self.open_reports())
            self.chat.insert(tk.END, " (click to open containing folder)\n", "system")
            self.chat.config(state="disabled")
            self.append_message("system", "Generated files (click names to open; thumbnails open full-size lightbox; [Download] saves a copy):", files=files)

            # Verbose chart engagements
            eng = compute_chart_engagements(self.last)
            verbose = (
                f"Chart Engagements (verbose):\n"
                f"• Area under thickness curve (age 1–100): {eng['area_under']:.0f} nm·years\n"
                f"• Area over 100 nm baseline: {eng['area_over']:.0f} nm·years\n"
                f"• Thickness value at current age ({self.last['age']:.1f}): {eng['value_at_current']:.1f} nm\n"
                f"You can ask in chat for a value at another age (e.g. 'value at 45')."
            )
            self.append_message("assistant", verbose)
            self.status.config(text=f"Analysis complete. Reports in {REPORT_DIR}")
        except Exception as e:
            self.append_message("system", f"Error: {e}")
            messagebox.showerror("Error", str(e))

