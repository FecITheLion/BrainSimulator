def clear_report_dir():
    """Keep only the current run's files by clearing previous ones."""
    if os.path.isdir(REPORT_DIR):
        for name in os.listdir(REPORT_DIR):
            path = os.path.join(REPORT_DIR, name)
            try:
                if os.path.isfile(path):
                    os.remove(path)
            except Exception:
                pass

def get_phase(age):
    for lo, hi, name, scale in PHASES:
        if lo <= age < hi:
            return name, scale
    return "Late Aging", 0.55

def parse_prompt(text):
    text = text.lower()
    age, ph, horm, id_flag = 32.0, 7.4, 1.0, 0
    ca, cyto = 1.2, 15.0
    patterns = {
        "age":  r'(age|years|yrs|old)\s*[:=]?\s*([-+]?\d*\.?\d+)',
        "ph":   r'(ph|acidity|alk|alkalinity)\s*[:=]?\s*([-+]?\d*\.?\d+)',
        "horm": r'(hormone|horm|thyroid|sex)\s*[:=]?\s*([-+]?\d*\.?\d+)',
        "ca":   r'(calcium|ca|ion|ca2)\s*[:=]?\s*([-+]?\d*\.?\d+)',
        "cyto": r'(cytokine|cyto|il6|tnf|inflammation)\s*[:=]?\s*([-+]?\d*\.?\d+)',
    }
    for key, pat in patterns.items():
        m = re.search(pat, text)
        if m:
            val = float(m.group(2).replace(",", "."))
            if key == "age": age = val
            elif key == "ph": ph = val
            elif key == "horm": horm = val
            elif key == "ca": ca = val
            elif key == "cyto": cyto = val
    if re.search(r'(disabled|id)\s*(true|yes|1)', text):
        id_flag = 1
    elif re.search(r'(disabled|id)\s*(false|no|0)', text):
        id_flag = 0
    else:
        m = re.search(r'(id|disabled)\s*[:=]?\s*(\d)', text)
        if m: id_flag = int(m.group(2))
    return age, ph, horm, id_flag, ca, cyto

def myelin_metrics(age, ph, horm, id_flag, ca, cyto):
    peak, base = 35.0, 150.0
    age_factor = math.exp(-0.5 * ((age - peak) / 20.0) ** 2)
    ph_factor = 1.0 if 7.1 <= ph <= 7.5 else 0.55
    horm_factor = max(0.4, horm)
    id_penalty = 0.65 if id_flag else 1.0
    ca_penalty = max(0.4, 1.0 - 0.25 * abs(ca - 1.2))
    cyto_penalty = max(0.3, 1.0 - (cyto / 100.0))
    thickness = base * age_factor * ph_factor * horm_factor * id_penalty * ca_penalty * cyto_penalty
    delta = thickness - 120.0
    g_ratio = max(0.55, min(0.95, 0.72 + (0.06 if id_flag else 0.0) - 0.08 * (delta / 50.0)))
    vel = 4.5 * 1.8 * (1.0 / g_ratio) * math.sqrt(max(thickness, 1.0) / 100.0)
    return thickness, delta, g_ratio, vel

def nn_forward(age, ph, horm, id_flag, ca, cyto, scale):
    W1 = [
        [0.15, 1.2, 2.1, -1.5, -0.4, -0.05],
        [0.05, 0.8, 0.5, -0.2, 0.9, -0.12],
        [-0.01, 0.1, -0.3, 0.0, -0.2, 0.45],
        [0.22, -0.4, 1.1, -0.8, 0.1, -0.30],
    ]
    b1 = [-1.5, 0.4, 0.15, -0.8]
    W2 = [
        [15.0, 5.0, -2.5, 8.0],
        [12.5, 3.1, -1.2, 4.5],
        [-0.02, 0.01, 0.04, -0.01],
    ]
    b2 = [-10.0, 5.0, 0.68]
    age_w = scale if scale > 1.0 else (2.0 - scale)
    x = [age * age_w, ph, horm * scale, float(id_flag), ca, cyto]
    h1 = [max(0.0, b1[r] + sum(W1[r][c] * x[c] for c in range(6))) for r in range(4)]
    out = [b2[r] + sum(W2[r][c] * h1[c] for c in range(4)) for r in range(3)]
    out[0] += 2.0 if scale >= 1.0 else -12.0
    return out

def generate_discharge_summary(data):
    age = data['age']
    sex = data['sex']
    thyroid = data['thyroid']
    symptom = data['symptom']
    myelination = data['myelination']
    inflammation = data['inflammation']
    cognitive = data['cognitive']
    phase = data['phase']
    cyto = data['cyto']
    ca = data['ca']
    thick = data['thick']
    delta = data['delta']
    g = data['g']
    vel = data['vel']

    thickness_desc = (
        "about average for the reference peak"
        if abs(delta) < 15
        else ("thinner than the reference peak" if delta < 0 else "thicker than the reference peak")
    )
    speed_desc = (
        "within a typical range"
        if 4 < vel < 20
        else ("on the slower side" if vel <= 4 else "on the faster side")
    )
    inflam_desc = (
        "low and not a major concern"
        if inflammation in ("None", "Low")
        else "elevated and something to keep an eye on"
    )
    myelin_map = {
        "Age-appropriate": "in line with what is expected for your age",
        "Delayed": "developing more slowly than usual",
        "Hypomyelination": "thinner than expected overall",
        "Demyelinating": "showing signs of loss or damage",
        "Remyelinating": "in a recovery or rebuilding phase",
    }
    myelin_desc = myelin_map.get(myelination, myelination.lower())
    symptom_phrase = (
        "no specific symptoms were reported"
        if symptom == "None"
        else f"the main concern noted was {symptom.lower()}"
    )

    summary = (
        f"Discharge Summary (in everyday language): You are a {age:.0f}-year-old {sex.lower()} "
        f"with {thyroid.lower()} thyroid function. On review, {symptom_phrase}, "
        f"and your thinking and memory ability is described as {cognitive.lower()}. "
        f"The protective myelin coating around your nerve fibers is currently {myelin_desc}. "
        f"Inflammation is {inflam_desc} (cytokine level about {cyto:.0f} pg/mL). "
        f"Calcium is at {ca:.2f} mmol/L. "
        f"The measured myelin thickness is approximately {thick:.0f} nanometers, which is {thickness_desc}. "
        f"Nerve signals are traveling at about {vel:.1f} meters per second ({speed_desc}), "
        f"and the coating efficiency (g-ratio) is {g:.2f}. "
        f"These findings place you in the {phase.lower()} stage of life, when the myelin coating "
        f"naturally peaks in adulthood and then gradually changes with age. "
        f"Overall, the results are consistent with expected changes for the {phase.lower()} period. "
        f"We recommend maintaining healthy lifestyle habits that support brain and nerve health "
        f"(such as regular activity, good sleep, and managing inflammation if it rises) "
        f"and following up with your physician if symptoms change. "
        f"This educational analysis is not a substitute for personal medical advice from a qualified doctor."
    )
    notes = []
    if data.get("dev_history"):
        notes.append(f"Hypothetical developmental history note: {data['dev_history']}")
    if data.get("behavior_obs"):
        notes.append(f"Hypothetical behavioral observation note: {data['behavior_obs']}")
    if data.get("ados2_note"):
        notes.append(f"Hypothetical ADOS-2 related note: {data['ados2_note']}")
    if data.get("adir_note"):
        notes.append(f"Hypothetical ADI-R related note: {data['adir_note']}")
    if notes:
        summary += (
            "\n\n--- Optional Hypothetical / Educational Notes (not clinical, do not affect myelin calculations) ---\n"
            + "\n".join(notes)
            + "\n\nWARNING: These notes or scores are user-entered hypothetical examples only. "
            "They are for educational illustration and are not clinical assessments, scores, or diagnoses."
        )
    return summary

def compute_chart_engagements(data):
    """Compute area under/over curve and point values for verbose chart interface."""
    ages = list(range(1, 101, 2))
    thicks = []
    for a in ages:
        t, _, _, _ = myelin_metrics(a, data['ph'], data['horm'], data['id_flag'], data['ca'], data['cyto'])
        thicks.append(t)
    # Trapezoidal area under curve
    area_under = sum((thicks[i] + thicks[i+1]) / 2 * (ages[i+1] - ages[i]) for i in range(len(ages)-1))
    baseline = 100.0  # reference
    area_over = sum(max(0, (thicks[i] + thicks[i+1]) / 2 - baseline) * (ages[i+1] - ages[i]) for i in range(len(ages)-1))
    # Value at current age (interpolate)
    age = data['age']
    if age <= ages[0]:
        val_at = thicks[0]
    elif age >= ages[-1]:
        val_at = thicks[-1]
    else:
        for i in range(len(ages)-1):
            if ages[i] <= age <= ages[i+1]:
                frac = (age - ages[i]) / (ages[i+1] - ages[i])
                val_at = thicks[i] + frac * (thicks[i+1] - thicks[i])
                break
        else:
            val_at = thicks[-1]
    return {
        "area_under": area_under,
        "area_over": area_over,
        "value_at_current": val_at,
        "ages": ages,
        "thicks": thicks
    }

def generate_charts(data, timestamp):
    """Generate chart PNGs and return list of paths."""
    if not HAS_MPL:
        return []
    paths = []
    age = data['age']
    ph = data['ph']
    horm = data['horm']
    id_flag = data['id_flag']
    ca = data['ca']
    cyto = data['cyto']

    # Age sweep chart
    ages = list(range(1, 101, 2))
    thicks, deltas, vels = [], [], []
    for a in ages:
        t, d, g, v = myelin_metrics(a, ph, horm, id_flag, ca, cyto)
        thicks.append(t)
        deltas.append(d)
        vels.append(v)
    fig, ax = plt.subplots(figsize=(8, 4))
    ax.plot(ages, thicks, label="Thickness (nm)", color="#4fc3f7")
    ax.axvline(age, color="red", linestyle="--", label=f"Current age {age:.0f}")
    ax.axhline(100, color="gray", linestyle=":", alpha=0.5, label="Baseline 100 nm")
    ax.set_xlabel("Age (years)")
    ax.set_ylabel("Myelin Thickness (nm)")
    ax.set_title("Myelin Thickness Across Lifespan")
    ax.legend()
    ax.grid(True, alpha=0.3)
    p1 = os.path.join(REPORT_DIR, "Featured_thickness_sweep.png")
    fig.tight_layout()
    fig.savefig(p1, dpi=120)
    plt.close(fig)
    paths.append(p1)

    # 3D sphere snapshot
    fig = plt.figure(figsize=(5, 5))
    ax = fig.add_subplot(111, projection="3d")
    u = [i * math.pi / 18 for i in range(19)]
    v = [i * 2 * math.pi / 18 for i in range(19)]
    xs, ys, zs = [], [], []
    for uu in u:
        for vv in v:
            xs.append(math.sin(uu) * math.cos(vv))
            ys.append(math.sin(uu) * math.sin(vv))
            zs.append(math.cos(uu))
    ax.plot(xs, ys, zs, color="#222", alpha=0.25, linewidth=0.3)
    theta = (age / 100.0) * math.pi
    phi = (ph - 7.2) * 4.0 * math.pi
    r = 1.0 + 0.006 * data['delta']
    px = r * math.sin(theta) * math.cos(phi)
    py = r * math.sin(theta) * math.sin(phi)
    pz = r * math.cos(theta)
    ax.scatter([px], [py], [pz], c="#e74c3c", s=80)
    ax.set_title("Spherical Embedding")
    p2 = os.path.join(REPORT_DIR, "Featured_sphere.png")
    fig.tight_layout()
    fig.savefig(p2, dpi=120)
    plt.close(fig)
    paths.append(p2)
    return paths

def generate_pdf(data, summary, chart_paths, timestamp):
    if not HAS_RL:
        return None
    pdf_path = os.path.join(REPORT_DIR, "Featured_discharge_summary.pdf")
    doc = SimpleDocTemplate(pdf_path, pagesize=letter, rightMargin=72, leftMargin=72, topMargin=72, bottomMargin=72)
    styles = getSampleStyleSheet()
    styles.add(ParagraphStyle(name="BodyJust", parent=styles["Normal"], alignment=4, spaceAfter=10))
    story = []
    story.append(Paragraph("Educational Myelin & Neuroinflammation Report", styles["Title"]))
    story.append(Spacer(1, 12))
    story.append(Paragraph(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}", styles["Normal"]))
    story.append(Spacer(1, 12))
    story.append(Paragraph("<b>Plain-Language Discharge Summary</b>", styles["Heading2"]))
    for para in summary.split("\n\n"):
        story.append(Paragraph(para.replace("\n", "<br/>"), styles["BodyJust"]))
    story.append(Spacer(1, 12))
    story.append(Paragraph("<b>Key Metrics</b>", styles["Heading2"]))
    metrics = [
        ["Metric", "Value"],
        ["Age", f"{data['age']:.1f} years"],
        ["Phase", data['phase']],
        ["Thickness", f"{data['thick']:.1f} nm"],
        ["Delta", f"{data['delta']:.1f} nm"],
        ["g-ratio", f"{data['g']:.3f}"],
        ["Velocity", f"{data['vel']:.1f} m/s"],
        ["Cytokines", f"{data['cyto']:.1f} pg/mL"],
        ["Calcium", f"{data['ca']:.2f} mmol/L"],
    ]
    tbl = Table(metrics, colWidths=[2.5*inch, 3*inch])
    tbl.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), colors.lightblue),
        ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
        ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
    ]))
    story.append(tbl)
    if chart_paths:
        story.append(Spacer(1, 18))
        story.append(Paragraph("<b>Charts</b>", styles["Heading2"]))
        for cp in chart_paths:
            if os.path.exists(cp):
                story.append(Spacer(1, 6))
                story.append(Image(cp, width=5.5*inch, height=2.8*inch))
    story.append(Spacer(1, 18))
    story.append(Paragraph(
        "<i>This report is generated for educational and illustrative purposes only. "
        "It is not a clinical diagnosis, medical advice, or substitute for professional evaluation.</i>",
        styles["Italic"]
    ))
    doc.build(story)
    return pdf_path

def generate_notes(data, summary, timestamp):
    notes_path = os.path.join(REPORT_DIR, "Featured_notes.txt")
    with open(notes_path, "w", encoding="utf-8") as f:
        f.write(f"Myelin Analysis Notes — {timestamp}\n")
        f.write("=" * 40 + "\n\n")
        f.write(summary)
        f.write("\n\n--- Raw Metrics ---\n")
        for k, v in data.items():
            if k not in ("nn",):
                f.write(f"{k}: {v}\n")
    return notes_path

